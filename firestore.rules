rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an authorized administrator
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*@adhamaadventures\\.co\\.tz')
      );
    }

    // --- Public Content (Read: All, Write: Admin) ---
    match /tours/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /destinations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /travel_calendar/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /inspiration_items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/sustainability {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Public Submissions (Write: Public, Read/Manage: Admin) ---
    match /enquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /appointments/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /newsletter/{email} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }
    match /visitor_logs/{id} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // --- Moderated Content ---
    match /testimonials/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if true; // Public submission
      allow update, delete: if isAdmin();
    }

    // --- Admin Identity Metadata ---
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Managed via Firebase Console
    }
    
    // --- User Profiles ---
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid || isAdmin();
    }
  }
}